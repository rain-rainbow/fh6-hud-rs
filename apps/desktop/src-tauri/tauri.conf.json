{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FH6 HUD 配置",
  "version": "0.1.0",
  "identifier": "com.rainrainbow.fh6hud",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FH6 HUD 配置",
        "width": 1060,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
